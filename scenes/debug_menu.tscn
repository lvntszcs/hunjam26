corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="DebugMenu" type="CanvasLayer"]
process_mode = 3
layer = 20
visible = false
script = ExtResource("1_menu")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Scroll" type="ScrollContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
follow_focus = true
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Scroll/Center"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Content" type="VBoxContainer" parent="Scroll/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Scroll/Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Debug menü"

[node name="Status" type="Label" parent="Scroll/Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(248, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Separator" type="HSeparator" parent="Scroll/Center/Panel/Content"]
layout_mode = 2

[node name="PhaseRow" type="HBoxContainer" parent="Scroll/Center/Panel/Content"]
layout_mode = 2

[node name="Label" type="Label" parent="Scroll/Center/Panel/Content/PhaseRow"]
